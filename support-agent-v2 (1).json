      "parameters": {
        "description": "Look up a customer order by order ID. Input: the order ID number only (for example 1001). Returns the item, status and delivery date.",
        "jsCode": "const orders = {\n  \"1001\": { item: \"Wireless Mouse\",       status: \"Shipped\",    delivery_date: \"2026-10-06\" },\n  \"1002\": { item: \"Phone Case\",           status: \"Processing\", delivery_date: \"2026-10-09\" },\n  \"1003\": { item: \"Bluetooth Headphones\", status: \"Delivered\",  delivery_date: \"2026-10-01\" },\n  \"1004\": { item: \"USB-C Cable (1m)\",     status: \"Cancelled\",  delivery_date: \"-\" },\n  \"1005\": { item: \"Mechanical Keyboard\",  status: \"Shipped\",    delivery_date: \"2026-10-07\" },\n  \"1006\": { item: \"Power Bank 10000mAh\",  status: \"Processing\", delivery_date: \"2026-10-10\" },\n  \"1007\": { item: \"Smart Watch\",          status: \"Delivered\",  delivery_date: \"2026-09-28\" },\n  \"1008\": { item: \"Webcam 1080p\",         status: \"Shipped\",    delivery_date: \"2026-10-05\" },\n  \"1009\": { item: \"Laptop Stand\",         status: \"Returned\",   delivery_date: \"-\" },\n  \"1010\": { item: \"Portable Speaker\",     status: \"Processing\", delivery_date: \"2026-10-11\" },\n  \"1011\": { item: \"Wall Charger 20W\",     status: \"Delivered\",  delivery_date: \"2026-09-30\" },\n  \"1012\": { item: \"Wired Earphones\",      status: \"Shipped\",    delivery_date: \"2026-10-06\" }\n};\n\nconst text = typeof query === \"string\" ? query : JSON.stringify(query);\nconst id = text.replace(/\\D/g, \"\");\nconst order = orders[id];\n\nif (!order) {\n  return \"No order found for ID \" + id;\n}\nreturn JSON.stringify({ order_id: id, ...order });"
      },
